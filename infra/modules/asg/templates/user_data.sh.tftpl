#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y httpd php php-mysqlnd php-cli jq unzip mariadb105

# Pull DB connection details from Secrets Manager (assignment-db-credentials)
# using this instance's IAM role - no credentials are ever hardcoded here.
SECRET_JSON=$(aws secretsmanager get-secret-value \
  --secret-id "${secret_arn}" \
  --region "${aws_region}" \
  --query SecretString --output text)

DB_HOST=$(echo "$SECRET_JSON" | jq -r .host)
DB_USER=$(echo "$SECRET_JSON" | jq -r .username)
DB_PASS=$(echo "$SECRET_JSON" | jq -r .password)
DB_NAME=$(echo "$SECRET_JSON" | jq -r .dbname)

cat <<EOF > /etc/httpd/conf.d/assignment-env.conf
SetEnv DB_HOST "$DB_HOST"
SetEnv DB_USER "$DB_USER"
SetEnv DB_PASS "$DB_PASS"
SetEnv DB_NAME "$DB_NAME"
SetEnv S3_BUCKET "${artifact_bucket}"
SetEnv AWS_REGION "${aws_region}"
EOF

mkdir -p /var/www/html

# Self-healing deploy: every new/replaced instance (scale-out, instance
# refresh, terraform apply after a destroy, etc.) pulls whatever was last
# shipped by the deploy.yml workflow, so the fleet never drifts back to the
# placeholder page after the first real deploy. Falls back to a placeholder
# only before any deploy has ever run.
if aws s3api head-object --bucket "${artifact_bucket}" --key "${artifact_key}" --region "${aws_region}" >/dev/null 2>&1; then
  aws s3 cp "s3://${artifact_bucket}/${artifact_key}" /tmp/assignment-app.zip --region "${aws_region}"
  rm -rf /var/www/html/*
  unzip -o /tmp/assignment-app.zip -d /var/www/html
else
  echo "<?php http_response_code(200); echo 'assignment-event-ticketing: bootstrapped, waiting for first deploy.';" \
    > /var/www/html/index.php
  # Matches healthz.php's contract (no DB dependency) so the ALB target group
  # already sees this instance as healthy before the first real deploy.
  echo "<?php http_response_code(200); header('Content-Type: text/plain'); echo 'ok';" \
    > /var/www/html/healthz.php
fi

systemctl enable httpd
systemctl restart httpd
