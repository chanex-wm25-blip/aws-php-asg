.DS_Store
**/.DS_Store
Thumbs.db

# PHP dependencies - installed by `composer install` (run locally, or by
# .github/workflows/deploy.yml before packaging the app for deploy).
# composer.lock IS committed on purpose, for reproducible installs.
shuttle-bus-ticketing/vendor/

# Build artifact produced by deploy.yml before upload to S3.
assignment-app.zip

# Terraform working files - never commit local state, provider cache, or plans.
# The real state lives in the assignment-tfstate S3 backend.
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfplan
# .terraform.lock.hcl IS intentionally committed for reproducible provider versions.
